# ─── Notelo server : variables d'environnement ───
# Copier en .env localement (ne pas commit), définir les valeurs réelles dans Render.

# Port d'écoute (Render le fournit automatiquement)
PORT=3000

# URL publique du serveur (utilisée pour les raccourcis /r/:code dans les SMS)
BASE_URL=https://notelo-server.onrender.com

# CORS — origines autorisées (CSV). Vide = autorise toutes les origines (dev only).
# Production recommandée : ALLOWED_ORIGINS=https://notelo.eu,https://www.notelo.eu
ALLOWED_ORIGINS=

# ─── Supabase ───
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# (optionnel mais recommandé) Mapping price ID → plan, pour détection robuste
# en lieu et place de la détection par montant. Récupérer dans Stripe > Products.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# ─── Brevo (SMS + emails transactionnels) ───
BREVO_API_KEY=xkeysib-...
# Nom expéditeur SMS (max 11 caractères alphanumériques)
BREVO_SENDER=Notelo

# ─── Admin ───
# Mot de passe pour accéder à GET /messages (header X-Admin-Key)
ADMIN_PASSWORD=change-me
# Email recevant les notifications de nouveaux messages contact
ADMIN_NOTIFICATION_EMAIL=contact@notelo.eu
